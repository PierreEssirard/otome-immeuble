# Copie ce fichier en ".env" et remplis UNE des deux options.
# Le fichier .env n'est jamais envoyé sur GitHub (il est dans .gitignore).

# Option 1 — Claude (recommandé) : clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Option 2 — Ollama (gratuit, en local) : https://ollama.com puis "ollama pull llama3.2"
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Version en ligne : URL de ton Cloudflare Worker (voir server/worker.js)
# VITE_CHAT_URL=https://otome-chat.ton-compte.workers.dev/api/chat
